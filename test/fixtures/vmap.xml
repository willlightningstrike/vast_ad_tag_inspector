<vmap:VMAP xmlns:vmap="http://www.iab.net/videosuite/vmap" version="1.0">
  <vmap:AdBreak timeOffset="start" breakType="linear" breakId="pre">
    <vmap:AdSource id="pre-ad" allowMultipleAds="false" followRedirects="true">
      <vmap:VASTAdData>
        <VAST version="3.0">
          <Ad id="p1">
            <InLine>
              <AdSystem>Example</AdSystem>
              <AdTitle>Preroll</AdTitle>
              <Impression><![CDATA[https://t.example/p1-imp]]></Impression>
              <Creatives>
                <Creative id="cp1">
                  <Linear>
                    <Duration>00:00:15</Duration>
                    <MediaFiles>
                      <MediaFile delivery="progressive" type="video/mp4" width="640" height="360"><![CDATA[https://t.example/p1.mp4]]></MediaFile>
                    </MediaFiles>
                  </Linear>
                </Creative>
              </Creatives>
            </InLine>
          </Ad>
        </VAST>
      </vmap:VASTAdData>
    </vmap:AdSource>
    <vmap:TrackingEvents>
      <vmap:Tracking event="breakStart"><![CDATA[https://t.example/bs]]></vmap:Tracking>
    </vmap:TrackingEvents>
  </vmap:AdBreak>
