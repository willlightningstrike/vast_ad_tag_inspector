      <vmap:AdTagURI templateType="vast3"><![CDATA[https://t.example/midtag]]></vmap:AdTagURI>
    </vmap:AdSource>
  </vmap:AdBreak>
  <vmap:AdBreak timeOffset="end" breakType="linear" breakId="post">
    <vmap:AdSource id="post-ad">
      <vmap:CustomAdData templateType="custom"><![CDATA[anything]]></vmap:CustomAdData>
    </vmap:AdSource>
  </vmap:AdBreak>
</vmap:VMAP>
